# Database configuration (Neon Postgres or Docker Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ar_option_test

# Server configuration
PORT=3000
HOST=0.0.0.0

# Signs login tokens. Required in production. Use a long random value.
JWT_SECRET=

# CORS allowlist (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

