{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ar-option-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiContainer"]
    }
  ]
}
